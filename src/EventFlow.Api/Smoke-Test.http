@baseUrl = http://localhost:5068

# Use inboxes you can access. Change these addresses before registering.
@attendeeEmail = attendee.smoke@example.com
@attendeePassword = SmokeTest123!
@organizerEmail = organizer.smoke@example.com
@organizerPassword = SmokeTest123!

# Scenario dates are calculated relative to the time each request is sent.
@registrationEnds = {{$datetime iso8601 30 d}}
@eventStarts = {{$datetime iso8601 60 d}}
@eventEnds = {{$datetime iso8601 61 d}}
@futureRegistrationStarts = {{$datetime iso8601 30 d}}

# Copy the latest OTP from each registration email before sending its confirmation request.
@attendeeConfirmationCode = REPLACE_WITH_ATTENDEE_OTP
@organizerConfirmationCode = REPLACE_WITH_ORGANIZER_OTP

# Use an event that you have manually opened for registration and a ticket type
# whose sales window is active. Publishing alone does not open registration.
@orderEventId = d383d7d2-1e79-4fe4-985d-7594035ecc28
@orderTicketTypeId = ba9ded6a-a3ca-4a6e-a60e-baed38d4ae89

# The result endpoint needs every signed query parameter from the Paymob redirect.
@paymentResultQuery = id=554076855&pending=false&amount_cents=2500&success=true&is_auth=false&is_capture=false&is_standalone_payment=true&is_voided=false&is_refunded=false&is_3d_secure=true&integration_id=5944413&profile_id=1233789&has_parent_transaction=false&order=632329214&created_at=2026-10-15T00%3A44%3A00.557149&currency=EGP&merchant_commission=0&accept_fees=0&discount_details=%5B%5D&amount_cents_int=2500&is_void=false&is_refund=false&error_occured=false&refunded_amount_cents=0&refunded_amount_cents_int=0&captured_amount=0&captured_amount_int=0&settlement_amount_cents_int=0&accept_fees_cents_int=0&vat_cents_int=0&updated_at=2026-10-15T00%3A44%3A23.595041&is_settled=false&bill_balanced=false&is_bill=false&owner=2478413&merchant_order_id=Ord-20261014214309-9953&data.message=Approved&source_data.type=card&source_data.pan=0007&source_data.sub_type=MasterCard&acq_response_code=00&txn_response_code=APPROVED&hmac=c86a080f77e0b708643f469108dc4277609b98feabb7d489aa1e7d4baaa348db815f0e8b99d49db1053742073e17e151f183d51a0a11591b3293dc32b1228e14

###############################################################################
# 1. Account setup
# Register each account once. On later runs, skip registration/confirmation and
# send the login requests. Change the email address if you need a new account.
###############################################################################

### Register organizer
# @name registerOrganizer
POST {{baseUrl}}/api/auth/register/organizer
Content-Type: application/json

{
  "name": "Smoke Test Organizer",
  "email": "{{organizerEmail}}",
  "phoneNumber": "+201143128894",
  "password": "{{organizerPassword}}",
  "organizationName": "Smoke Test Events",
  "organizationDescription": "Organization used for the EventFlow API smoke test."
}

### Resend organizer confirmation (optional; only if a new OTP is needed)
POST {{baseUrl}}/api/auth/resend-confirmation
Content-Type: application/json

{
  "email": "{{organizerEmail}}"
}

### Confirm organizer email
POST {{baseUrl}}/api/auth/confirm-email
Content-Type: application/json

{
  "email": "{{organizerEmail}}",
  "code": "{{organizerConfirmationCode}}"
}

### Login organizer
# @name organizerLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{organizerEmail}}",
  "password": "{{organizerPassword}}"
}

### Register attendee
# @name registerAttendee
POST {{baseUrl}}/api/auth/register/attendee
Content-Type: application/json

{
  "name": "Smoke Test Attendee",
  "email": "{{attendeeEmail}}",
  "phoneNumber": "+201207193498",
  "password": "{{attendeePassword}}"
}

### Resend attendee confirmation (optional; only if a new OTP is needed)
POST {{baseUrl}}/api/auth/resend-confirmation
Content-Type: application/json

{
  "email": "{{attendeeEmail}}"
}

### Confirm attendee email
POST {{baseUrl}}/api/auth/confirm-email
Content-Type: application/json

{
  "email": "{{attendeeEmail}}",
  "code": "{{attendeeConfirmationCode}}"
}

### Login attendee
# @name attendeeLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{attendeeEmail}}",
  "password": "{{attendeePassword}}"
}

###############################################################################
# 2. Organizer event and ticket-type paths
# These requests create and publish a separate event for event-management tests.
# Publishing does not open registration in the current API, so this event is not
# used by the checkout flow below.
###############################################################################

### Create event
# @name createEvent
POST {{baseUrl}}/api/events
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "eventName": "EventFlow Smoke Test Conference",
  "description": "A sample event used to exercise the EventFlow API.",
  "location": "Convention Centre, Test City",
  "startDate": "{{eventStarts}}",
  "endDate": "{{eventEnds}}",
  "registrationStart": "{{futureRegistrationStarts}}",
  "registrationEnd": "{{registrationEnds}}",
  "visibility": 0
}

### Update event details
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/details
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "eventName": "EventFlow Smoke Test Conference Updated",
  "description": "Updated sample event details for the API smoke test."
}

### Update event location
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/location
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "location": "Updated Convention Centre, Test City"
}

### Update event schedule
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/schedule
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "startDate": "{{$datetime iso8601 70 d}}",
  "endDate": "{{$datetime iso8601 71 d}}"
}

### Update event registration period
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/registration-period
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "registrationStart": "{{$datetime iso8601 2 d}}",
  "registrationEnd": "{{$datetime iso8601 40 d}}"
}

### Update event visibility (0 = public)
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/visibility
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "visibility": 0
}

### List organizer events
GET {{baseUrl}}/api/events?page=1&pageSize=10
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Get event by ID
GET {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Create ticket type
# @name createTicketType
POST {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Smoke Test General Admission",
  "price": 25.00,
  "capacity": 100,
  "salesStart": "{{futureRegistrationStarts}}",
  "salesEnd": "{{registrationEnds}}"
}

### Update ticket type name
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types/{{createTicketType.response.body.$.id}}/name
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Smoke Test Standard Admission"
}

### Update ticket type price
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types/{{createTicketType.response.body.$.id}}/price
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "price": 30.00
}

### Update ticket type capacity
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types/{{createTicketType.response.body.$.id}}/capacity
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "capacity": 120
}

### Update ticket type sales window
PUT {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types/{{createTicketType.response.body.$.id}}/sales-window
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "salesStart": "{{$datetime iso8601 2 d}}",
  "salesEnd": "{{$datetime iso8601 40 d}}"
}

### List ticket types for the new event
GET {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types?page=1&pageSize=10
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Get ticket type by ID
GET {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types/{{createTicketType.response.body.$.id}}
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Publish event (requires at least one ticket type)
POST {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/publish
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Browse public events
GET {{baseUrl}}/api/public/events?page=1&pageSize=10&searchTerm=EventFlow

### Get the published event publicly
GET {{baseUrl}}/api/public/events/{{createEvent.response.body.$.id}}

###############################################################################
# 3. Attendee order and payment paths
# Run these against the configured event/ticket above. Registration is not
# opened automatically; it must already be open and the ticket must be on sale.
###############################################################################

### Create order
# @name createOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "eventId": "{{orderEventId}}",
  "items": [
    {
      "ticketTypeId": "{{orderTicketTypeId}}",
      "quantity": 1
    }
  ]
}

### Get the newly created order
GET {{baseUrl}}/api/orders/{{createOrder.response.body.$.id}}
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}

### List attendee orders
GET {{baseUrl}}/api/orders/my-orders?page=1&pageSize=10
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}

### Initiate payment for the pending order
# @name initiatePayment
POST {{baseUrl}}/api/payments/initiate
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "orderId": "{{createOrder.response.body.$.id}}"
}

# Copy paymentUrl from initiatePayment's response, open it in a browser, and
# complete payment with the Paymob test-card details for your configured account.
# A real Paymob setup and reachable RedirectionUrl/NotificationUrl are required
# for payment confirmation and ticket issuance. The API does not mark an order
# paid merely because payment was initiated.
# Paymob sends its signed server callback to the configured /api/payments/webhook;
# do not send an empty/fabricated webhook body to simulate payment success.

### Recheck a Paymob redirect result (optional; paste the complete signed query string above)
GET {{baseUrl}}/api/payments/result?{{paymentResultQuery}}

### Verify tickets were issued after the successful provider callback
# @name myTickets
GET {{baseUrl}}/api/tickets/my-tickets?page=1&pageSize=10
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}

### Get ticket details and QR code for the first returned ticket
# @name ticketDetails
GET {{baseUrl}}/api/tickets/{{myTickets.response.body.$.items[0].id}}
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}

###############################################################################
# 4. Organizer order and check-in paths
###############################################################################

### List event orders
GET {{baseUrl}}/api/events/{{orderEventId}}/orders?page=1&pageSize=10
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### List event tickets
GET {{baseUrl}}/api/events/{{orderEventId}}/tickets?page=1&pageSize=10
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### List ticket types for the event
GET {{baseUrl}}/api/events/{{orderEventId}}/ticket-types?page=1&pageSize=10
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Check in attendee using the paid ticket QR code
POST {{baseUrl}}/api/events/{{orderEventId}}/check-in
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "qrCode": "{{ticketDetails.response.body.$.qrCode}}"
}

### Get event check-in statistics
GET {{baseUrl}}/api/events/{{orderEventId}}/check-in/stats
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

###############################################################################
# 5. Other order and authentication paths
###############################################################################

### Create a second pending order for cancellation testing
# @name createOrderForCancellation
POST {{baseUrl}}/api/orders
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "eventId": "{{orderEventId}}",
  "items": [
    {
      "ticketTypeId": "{{orderTicketTypeId}}",
      "quantity": 1
    }
  ]
}

### Cancel the second pending order
DELETE {{baseUrl}}/api/orders/{{createOrderForCancellation.response.body.$.id}}
Authorization: Bearer {{attendeeLogin.response.body.$.accessToken}}

### Refresh attendee access and refresh tokens
# @name refreshAttendee
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "accessToken": "{{attendeeLogin.response.body.$.accessToken}}",
  "refreshToken": "{{attendeeLogin.response.body.$.refreshToken}}"
}

### Log out attendee and revoke the rotated refresh token
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{refreshAttendee.response.body.$.accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{refreshAttendee.response.body.$.refreshToken}}"
}

###############################################################################
# 6. Optional account maintenance and cleanup
# Password reset changes the attendee password; update @attendeePassword before
# logging in again. Cleanup is destructive and should only be run for test data.
###############################################################################

### Request attendee password reset
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{attendeeEmail}}"
}

### Reset attendee password (use the OTP from the password-reset email)
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "{{attendeeEmail}}",
  "code": "REPLACE_WITH_PASSWORD_RESET_OTP",
  "newPassword": "SmokeTest456!",
  "confirmPassword": "SmokeTest456!"
}

### Cancel the event created by this file (optional; destructive)
POST {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/cancel
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}

### Delete the ticket type created by this file (optional; destructive)
DELETE {{baseUrl}}/api/events/{{createEvent.response.body.$.id}}/ticket-types/{{createTicketType.response.body.$.id}}
Authorization: Bearer {{organizerLogin.response.body.$.accessToken}}
